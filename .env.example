# ==============================================================================
# ACADIA BAKERY & BISTRO — ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and customize values for local development or production.

# Django Security
DEBUG=True
SECRET_KEY=django-insecure-acadia-bakery-lagos-super-secret-key-change-in-prod-2026
ALLOWED_HOSTS=127.0.0.1,localhost,acadia.ng,www.acadia.ng

# Database Settings
# By default, SQLite is used for development (db.sqlite3).
# For production PostgreSQL, set:
# DATABASE_URL=postgres://user:password@hostname:5432/acadia_db

# Paystack Payment Gateway Integration
# In development, manual bank transfer and Paystack test keys can be configured.
# Obtain API keys from your Paystack dashboard: https://dashboard.paystack.com/#/settings/developer
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Business Information Defaults (can also be configured via Staff CMS at /cms/settings/)
BUSINESS_NAME=Acadia
BUSINESS_PHONE=+234 801 234 5678
BUSINESS_WHATSAPP=+234 801 234 5678
BUSINESS_EMAIL=hello@acadia.ng
BUSINESS_ADDRESS=14 Victoria Island Crescent, Lagos, Nigeria
